{
  "name": "@fedex/prism-user",
  "private": true,
  "version": "1.0.0",
  "description": "Prism providers and services for fetching and modifying data",
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "scripts": {
    "build": "tsdown",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "verify": "pnpm run lint && pnpm run typecheck && pnpm run build"
  },
  "devDependencies": {
    "tsdown": "^0.23.1"
  },
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "zod": "^4.6.7"
  }
}
