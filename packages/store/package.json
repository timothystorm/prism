{
  "name": "@fedex/prism-store",
  "version": "1.0.0",
  "description": "Prism application store and state schemas",
  "keywords": [],
  "author": "Timothy Storm <timothystorm@gmail.com>",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "scripts": {
    "build": "tsdown",
    "compile": "pnpm tsc --noEmit",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "verify": "pnpm run check && pnpm run typecheck && pnpm run test",
    "watch": "vitest --watch"
  },
  "dependencies": {
    "immer": "^11.1.21",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "tsdown": "^0.23.1"
  },
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "files": [
    "dist"
  ]
}
