  "private": true,
  "scripts": {
    "check": "biome check .",
    "check:ci": "biome ci .",
    "check:fix": "biome check --write .",
    "format": "biome format --write .",
    "prepare": "husky",
    "test": "vitest --run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "pnpm -r --if-present typecheck",
    "verify": "pnpm run check && pnpm run typecheck && pnpm run test:coverage",
    "watch": "vitest --watch"
